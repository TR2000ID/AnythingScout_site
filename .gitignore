# Installed packages and build output
node_modules/
web/dist/
*.tsbuildinfo

# The Worker: its local secrets and wrangler's cache
.dev.vars
worker/.dev.vars
.wrangler/

# Python (browser checks)
__pycache__/
*.pyc

# Plan-execution scratch (superpowers)
.superpowers/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Games: update_steam.py's daily output (dated copies + latest.json, which points at them). Git keeps the
# plain-named starting copy (games.json...) instead, so the repo doesn't grow every day
web/public/data/games/steam/*.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9].*
web/public/data/games/steam/latest.json
web/public/data/games/**/*.tmp
# One-time copy of Game Scout ratings (tools/read_game_ratings.py): personal, never committed
web/.carry/

# Daily live deploy (tools/deploy_live.py): its log and what it deployed last
.deploy_live/
