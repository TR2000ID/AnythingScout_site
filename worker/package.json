{
  "name": "anime-scout-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8789",
    "deploy": "node -e \"console.error('No deploy until go-live (step 4): this Worker is named anime-scout and would replace the live Anime Scout site. See README.'); process.exit(1)\"",
    "deploy:golive": "npm --prefix ../web run build && wrangler deploy",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260927.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
